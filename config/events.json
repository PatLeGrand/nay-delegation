{
  "directory": ".nay/state/events",
  "maxOutputLines": 100,
  "maxOutputChars": 12000,
  "maxFileBytes": 10485760,
  "maxRotatedFiles": 5,
  "secretPatterns": [
    {
      "pattern": "(\"[A-Za-z0-9_.-]*?(?:(?<![A-Za-z0-9])|(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z]))(?:[kK][eE][yY]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[aA][pP][iI])(?=[^A-Za-z0-9]|[A-Z][a-z]|$)[A-Za-z0-9_.-]*\"[ \\t]*:[ \\t]*\")((?:\\\\.|[^\"\\\\])*)(\")",
      "replacement": "$1[masqué]$3",
      "flags": "g"
    },
    {
      "pattern": "(\\b[A-Za-z0-9_.-]*?(?:(?<![A-Za-z0-9])|(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z]))(?:[kK][eE][yY]|[tT][oO][kK][eE][nN]|[sS][eE][cC][rR][eE][tT]|[pP][aA][sS][sS][wW][oO][rR][dD]|[aA][pP][iI])(?=[^A-Za-z0-9]|[A-Z][a-z]|$)[A-Za-z0-9_.-]*[ \\t]*=[ \\t]*)(?:\"(?:\\\\.|[^\"\\\\\\n])*\"|'(?:\\\\.|[^'\\\\\\n])*'|[^\\s;&|]+)",
      "replacement": "$1[masqué]",
      "flags": "g"
    },
    {
      "pattern": "(\\b(?:Authorization[ \\t]*:[ \\t]*)?Bearer[ \\t]+)[A-Za-z0-9._~+/=-]{16,}",
      "replacement": "$1[masqué]",
      "flags": "gi"
    },
    {
      "pattern": "\\b(?:sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[A-Z0-9]{16}(?![A-Za-z0-9])|xox[bp]-[A-Za-z0-9-]{20,})",
      "replacement": "[masqué]",
      "flags": "g"
    }
  ],
  "tools": {
    "Bash": { "kind": "command", "targets": ["command"] },
    "command_execution": { "kind": "command", "targets": ["command"] },
    "run_command": { "kind": "command", "targets": ["CommandLine", "command"] },
    "Read": { "kind": "read", "targets": ["file_path"] },
    "read_file": { "kind": "read", "targets": ["Path", "path"] },
    "view_file": { "kind": "read", "targets": ["AbsolutePath", "path"] },
    "Edit": { "kind": "edit", "targets": ["file_path"] },
    "Write": { "kind": "edit", "targets": ["file_path"] },
    "file_change": { "kind": "edit", "targets": ["changes"] },
    "replace_file_content": { "kind": "edit", "targets": ["TargetFile"] },
    "multi_replace_file_content": { "kind": "edit", "targets": ["TargetFile"] },
    "write_to_file": { "kind": "edit", "targets": ["TargetFile"] },
    "Grep": { "kind": "search", "targets": ["pattern"] },
    "Glob": { "kind": "search", "targets": ["pattern"] },
    "grep_search": { "kind": "search", "targets": ["SearchPath", "Query"] },
    "find_by_name": { "kind": "search", "targets": ["Pattern"] },
    "WebSearch": { "kind": "web", "targets": ["query"] },
    "WebFetch": { "kind": "web", "targets": ["url"] },
    "web_search": { "kind": "web", "targets": ["query"] },
    "search_web": { "kind": "web", "targets": ["query", "Query"] },
    "read_url_content": { "kind": "web", "targets": ["Url"] }
  }
}
